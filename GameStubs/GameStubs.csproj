<Project Sdk="Microsoft.NET.Sdk">

  <!-- Name-only stand-in for the game's Assembly-CSharp.dll, so the mod compiles on CI. See README.md. Not in the solution. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <RootNamespace>GameStubs</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- UI/ holds its own project; keep its files out of this one. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);UI/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.32" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="UI\GameStubs.UI.csproj" Private="false" />
  </ItemGroup>

</Project>
